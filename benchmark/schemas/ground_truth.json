{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ground Truth V1.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "type": "string"
    },
    "expected_recommendation": {
      "type": "string",
      "enum": [
        "PAY",
        "HOLD",
        "INVESTIGATE"
      ]
    },
    "expected_exception_name": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "case_id",
    "expected_recommendation",
    "expected_exception_name"
  ]
}