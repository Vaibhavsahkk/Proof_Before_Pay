# Environment Configuration Example

# Phase 0 requires NO API key.
# Do not populate any API key during Phase 0.

# If a model API is authorized in a later approved phase, the Gemini API will be used.
# Set a real key ONLY via local environment variable or approved secret store.
# Never commit a real key to this file.
# GEMINI_API_KEY=your_gemini_api_key_here

LOG_LEVEL=INFO
