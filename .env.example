# Environment Configuration Example

# Phase 0 requires NO API key.
# Do not populate any API key during Phase 0.

# If a model API is authorized in a later approved phase, the Gemini API will be used.
# Set a real key ONLY via local environment variable or approved secret store.
# Never commit a real key to this file.
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional OpenAI-compatible TokenRouter mode for the configured NVIDIA/GLM models.
# Set these only in the local process environment or an approved secret store.
# LLM_PROVIDER=tokenrouter
# TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
# TOKENROUTER_API_KEY=your_tokenrouter_api_key_here
# TOKENROUTER_EXTRACTION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# TOKENROUTER_OCR_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# TOKENROUTER_EXPLANATION_MODEL=z-ai/glm-5.3:free

LOG_LEVEL=INFO
